{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Machete PS5 Backup Manager",
  "version": "2.2.0",
  "identifier": "com.thebigmike.machete",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Machete PS5 Backup Manager",
        "width": 1100,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish",
          "French",
          "German",
          "Italian",
          "Japanese",
          "Portuguese",
          "Russian",
          "Korean",
          "SimpChinese"
        ]
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5MTZDOEM0RTdDOEIzMEIKUldRTHM4am54TWdXS1E0Q2RBaGFwRzF6VmRQYW1CdlpjRTZxV1hENEJtRGY3eDU5NmxHZ0F2dVcK",
      "endpoints": [
        "https://github.com/VenezuelanBiggie24/Machete-PS5-Backup-Manager/releases/latest/download/latest.json"
      ]
    }
  }
}